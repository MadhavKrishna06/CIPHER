# Copy to .env and adjust. .env is gitignored.

# Local LLM served by Ollama (http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Paths (relative to repo root)
RAW_DIR=data/raw
CHROMA_DIR=data/chroma
MANIFEST_PATH=data/manifest.json

# Chunking
CHUNK_WORDS=500
CHUNK_OVERLAP_WORDS=50

# Retrieval quality. Chroma returns a distance (lower = closer). If the best
# chunk is farther than this, the answer is supplemented with web references.
WEAK_MATCH_DISTANCE=0.9

# Internet citation lookup. DuckDuckGo needs no API key.
# Set to false to run fully offline (used for the local-only Wireshark capture).
WEB_SEARCH_ENABLED=true
